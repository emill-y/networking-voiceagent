# Copy to backend/.env and adjust. backend/.env is ignored by Git.

# Speech-to-text provider:
#   local       - faster-whisper on this machine (audio never leaves it)
#   huggingface - hosted Whisper via Hugging Face Inference Providers.
#                 Faster on a laptop, but recordings are sent to a third party.
TRANSCRIPTION_PROVIDER=local
# Needed only for huggingface. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_INFERENCE_PROVIDER=fal-ai
HF_ASR_MODEL=openai/whisper-large-v3

# Local faster-whisper. small.en is the default; tiny.en is faster for quick tests.
WHISPER_MODEL=small.en
# auto | cpu | cuda
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=10

# Local LLM through Ollama (`ollama pull qwen3:4b`).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Supabase Postgres connection string (Project Settings -> Database).
# Local Supabase CLI default shown. Never commit a real password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Browser origins allowed by CORS (Expo web preview).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
