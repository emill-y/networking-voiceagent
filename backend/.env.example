# Copy to backend/.env and adjust. backend/.env is ignored by Git.

# Speech-to-text provider:
#   local       - faster-whisper on this machine (audio never leaves it)
#   huggingface - hosted Whisper via Hugging Face Inference Providers.
#                 Faster on a laptop, but recordings are sent to a third party.
TRANSCRIPTION_PROVIDER=local
# Needed only for huggingface. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_INFERENCE_PROVIDER=fal-ai
HF_ASR_MODEL=openai/whisper-large-v3

# Local faster-whisper. small.en is the default; tiny.en is faster for quick tests.
WHISPER_MODEL=small.en
# auto | cpu | cuda
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=10

# Local LLM through Ollama (`ollama pull qwen3:4b`).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Supabase Auth: the app sends a Supabase access token; we verify it here.
SUPABASE_URL=https://qebslfifekeswyesddpr.supabase.co
# Only if your project still uses the legacy shared JWT secret (HS256).
SUPABASE_JWT_SECRET=
# Local development without Supabase: skip sign-in, act as one dev user.
# Never enable on a server other people can reach.
NOMI_DEV_AUTH=false

# Supabase Postgres connection string: dashboard -> Connect -> Session pooler.
# Replace [YOUR-PASSWORD] with the database password. If it contains
# characters like @ : / # ?, percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.qebslfifekeswyesddpr:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Browser origins allowed by CORS (Expo web preview).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
