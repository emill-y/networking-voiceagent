# Copy to backend/.env and adjust. backend/.env is ignored by Git.

# Server-side speech-to-text (used when the app can't transcribe on the phone,
# e.g. in Expo Go):
#   openai_compatible - hosted Whisper at LLM_BASE_URL (Groq): fast, same key
#   local             - faster-whisper on this machine (slow; audio stays local)
#   huggingface       - Hugging Face Inference Providers
TRANSCRIPTION_PROVIDER=openai_compatible
STT_MODEL=whisper-large-v3-turbo
# Needed only for huggingface. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_INFERENCE_PROVIDER=fal-ai
HF_ASR_MODEL=openai/whisper-large-v3

# Local faster-whisper. small.en is the default; tiny.en is faster for quick tests.
WHISPER_MODEL=small.en
# auto | cpu | cuda
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=10

# Language model. Groq (hosted, fast) is the default.
# NOTE: this key is committed on purpose because the repository is private.
# If the repo ever becomes public or is shared, revoke it at
# https://console.groq.com/keys and remove it from Git history.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=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
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model; "low" keeps extraction fast.
LLM_REASONING_EFFORT=low
# Used when the main model hits a rate limit (Groq limits are per model).
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# To use a local model instead: LLM_PROVIDER=ollama, then `ollama pull qwen3:4b`.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Supabase Auth: the app sends a Supabase access token; we verify it here.
SUPABASE_URL=https://qebslfifekeswyesddpr.supabase.co
# Only if your project still uses the legacy shared JWT secret (HS256).
SUPABASE_JWT_SECRET=
# Local development without Supabase: skip sign-in, act as one dev user.
# Never enable on a server other people can reach.
NOMI_DEV_AUTH=false

# Contact address shown on the website (/) and privacy policy (/privacy).
SUPPORT_EMAIL=

# Supabase Postgres connection string: dashboard -> Connect -> Session pooler.
# Replace [YOUR-PASSWORD] with the database password. If it contains
# characters like @ : / # ?, percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.qebslfifekeswyesddpr:[YOUR-PASSWORD]@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# Browser origins allowed by CORS (Expo web preview).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Google Calendar sync (optional). Add http://localhost:8000/calendar/callback
# to the OAuth client's redirect URIs to try it locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_ENCRYPTION_KEY=
PUBLIC_URL=
