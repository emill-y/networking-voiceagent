# Optional for an iOS simulator or web browser on your Mac.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical phone: replace 127.0.0.1 with your Mac's LAN IP.
# Android emulator: use http://10.0.2.2:8000 instead.

# Supabase sign-in. The publishable key (sb_publishable_...) is safe to ship
# in the app; it can't read data without a signed-in user. Find both under
# Project Settings -> API. Leave these unset for local development without
# sign-in (the backend then needs NOMI_DEV_AUTH=true).
EXPO_PUBLIC_SUPABASE_URL=https://qebslfifekeswyesddpr.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
