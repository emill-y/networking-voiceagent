{
  "expo": {
    "name": "Nomi",
    "slug": "nomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.network.nomi",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Nomi uses the microphone only during a session you start, to remember the people you meet. Audio is transcribed and never stored.",
        "NSPhotoLibraryUsageDescription": "Nomi lets you choose a profile photo from your library. It never reads your photos otherwise.",
        "NSPhotoLibraryAddUsageDescription": "Nomi only saves an image to your library when you ask it to.",
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.network.nomi",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Nomi",
      "shortName": "Nomi",
      "themeColor": "#FAF9F6",
      "backgroundColor": "#FAF9F6",
      "description": "A private memory for the people you meet."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nomi uses the microphone only during a session you start, to remember the people you meet. Audio is transcribed and never stored.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "backgroundColor": "#FAF9F6",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ed04415-73dd-4f25-8fa0-312fa666d0c8"
      }
    }
  }
}
