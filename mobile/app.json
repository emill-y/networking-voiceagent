{
  "expo": {
    "name": "Nomi",
    "slug": "nomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomi",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nomi.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Nomi uses the microphone only while you record a note about someone you met.",
        "NSSpeechRecognitionUsageDescription": "Nomi turns your spoken notes into text, on your iPhone whenever possible.",
        "NSContactsUsageDescription": "Nomi lets you choose people from your contacts to remember. Your address book stays on your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171A1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nomi.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171A1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nomi uses the microphone only while you record a note about someone you met.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Nomi lets you choose people from your contacts to remember. Your address book stays on your phone."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nomi uses the microphone only while you record a note about someone you met.",
          "speechRecognitionPermission": "Nomi turns your spoken notes into text, on your iPhone whenever possible."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#171A1D",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171A1D"
    }
  }
}
